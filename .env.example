# ── DB ─────────────────────────────────────────────
# 비워두면 로컬 PGlite(./.pglite) 사용. 운영 DB 사용 시 설정 후 `pnpm db:migrate` 1회 실행
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/saehan?sslmode=require
# PGLITE_DIR=./.pglite

# 원격 DB 데이터를 로컬로 가져올 때 (pnpm db:import-remote, 읽기 전용 접속)
# SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/saehan?sslmode=require

# ── 앱 ─────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
# Vercel Cron → /api/alerts/evaluate 인증 (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me
# 채널 webhook URL/전화번호 암호화 키 (운영 필수, 변경 시 기존 채널 재등록 필요)
ALERT_SECRET_KEY=change-me-to-a-long-random-string

# true 면 실제 발송 없이 콘솔에만 출력
ALERT_DRY_RUN=false
# true 면 정상 복구 시 복구 알림 발송
ALERT_SEND_RECOVERY=false

# ── 이메일 (둘 중 하나) ─────────────────────────────
# RESEND_API_KEY=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL_FROM=EMS 알림 <noreply@example.com>

# ── 카카오 알림톡 (Solapi) ──────────────────────────
# KAKAO_API_KEY=
# KAKAO_API_SECRET=
# KAKAO_PF_ID=          # 발신 프로필 ID
# KAKAO_TEMPLATE_ID=    # 승인된 템플릿 ID
# KAKAO_SENDER=         # 발신 번호 (대체 문자 발송용)
